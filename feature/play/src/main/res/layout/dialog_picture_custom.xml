<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <LinearLayout
        android:layout_width="@dimen/vs_700"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_user_pause"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_45"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/preset_custom_adjust"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_26"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_pc_close"
                android:layout_width="@dimen/vs_40"
                android:layout_height="@dimen/vs_40"
                android:background="@drawable/button_player_control"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_160"
                android:layout_height="wrap_content"
                android:text="@string/picture_saturation"
                android:textColor="@color/color_FFFFFF_80"
                android:textSize="@dimen/ts_22" />

            <SeekBar
                android:id="@+id/sb_saturation"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_40"
                android:layout_weight="1"
                android:focusable="true"
                android:max="150" />

            <TextView
                android:id="@+id/tv_saturation"
                android:layout_width="@dimen/vs_80"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_160"
                android:layout_height="wrap_content"
                android:text="@string/picture_contrast"
                android:textColor="@color/color_FFFFFF_80"
                android:textSize="@dimen/ts_22" />

            <SeekBar
                android:id="@+id/sb_contrast"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_40"
                android:layout_weight="1"
                android:focusable="true"
                android:max="130" />

            <TextView
                android:id="@+id/tv_contrast"
                android:layout_width="@dimen/vs_80"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_160"
                android:layout_height="wrap_content"
                android:text="@string/picture_brightness"
                android:textColor="@color/color_FFFFFF_80"
                android:textSize="@dimen/ts_22" />

            <SeekBar
                android:id="@+id/sb_brightness"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_40"
                android:layout_weight="1"
                android:focusable="true"
                android:max="40" />

            <TextView
                android:id="@+id/tv_brightness"
                android:layout_width="@dimen/vs_80"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_160"
                android:layout_height="wrap_content"
                android:text="@string/picture_gamma"
                android:textColor="@color/color_FFFFFF_80"
                android:textSize="@dimen/ts_22" />

            <SeekBar
                android:id="@+id/sb_gamma"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_40"
                android:layout_weight="1"
                android:focusable="true"
                android:max="150" />

            <TextView
                android:id="@+id/tv_gamma"
                android:layout_width="@dimen/vs_80"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_160"
                android:layout_height="wrap_content"
                android:text="@string/picture_temperature"
                android:textColor="@color/color_FFFFFF_80"
                android:textSize="@dimen/ts_22" />

            <SeekBar
                android:id="@+id/sb_temperature"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_40"
                android:layout_weight="1"
                android:focusable="true"
                android:max="200" />

            <TextView
                android:id="@+id/tv_temperature"
                android:layout_width="@dimen/vs_80"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_160"
                android:layout_height="wrap_content"
                android:text="@string/picture_hue"
                android:textColor="@color/color_FFFFFF_80"
                android:textSize="@dimen/ts_22" />

            <SeekBar
                android:id="@+id/sb_hue"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_40"
                android:layout_weight="1"
                android:focusable="true"
                android:max="360" />

            <TextView
                android:id="@+id/tv_hue"
                android:layout_width="@dimen/vs_80"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_160"
                android:layout_height="wrap_content"
                android:text="@string/picture_sharpen"
                android:textColor="@color/color_FFFFFF_80"
                android:textSize="@dimen/ts_22" />

            <SeekBar
                android:id="@+id/sb_sharpen"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_40"
                android:layout_weight="1"
                android:focusable="true"
                android:max="80" />

            <TextView
                android:id="@+id/tv_sharpen"
                android:layout_width="@dimen/vs_80"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_160"
                android:layout_height="wrap_content"
                android:text="@string/picture_shadow"
                android:textColor="@color/color_FFFFFF_80"
                android:textSize="@dimen/ts_22" />

            <SeekBar
                android:id="@+id/sb_shadow"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_40"
                android:layout_weight="1"
                android:focusable="true"
                android:max="60" />

            <TextView
                android:id="@+id/tv_shadow"
                android:layout_width="@dimen/vs_80"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_50"
            android:layout_marginTop="@dimen/vs_20"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_pc_default"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_player_control"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/picture_reset_default"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/btn_pc_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/button_player_control"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/dialog_cancel"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/btn_pc_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/button_player_control"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/dialog_confirm"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
