<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
<!-- 聚合搜索页面 -->
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_50"
        android:layout_marginTop="@dimen/vs_10"
        android:layout_marginBottom="@dimen/vs_10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_20">

        <TextView
            android:id="@+id/mSearchTitle"
            android:layout_width="@dimen/vs_220"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="@dimen/vs_40"
            android:background="@drawable/bg_fast_search_status"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lines="2"
            android:maxLines="2"
            android:text="&#x51C6;&#x5907;&#x641C;&#x7D22;&#10;&#x7ED3;&#x679C; 0"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_16" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/vs_5"
            android:gravity="center_vertical"
            android:text="@string/search_current_word"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/mSearchWord"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_50"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="@dimen/vs_20"
            android:background="@drawable/shape_user_search"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_10"
            android:layout_marginRight="@dimen/vs_5"
            android:gravity="center_vertical"
            android:text="@string/search_recommend_words"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridViewWordFenci"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_50"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_5" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/llWord"
            android:layout_width="@dimen/vs_240"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="20mm"
            android:paddingBottom="@dimen/vs_20">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewWord"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_20"
            android:paddingBottom="@dimen/vs_20"
            android:paddingRight="@dimen/vs_20"
            tools:ignore="InOrMmUsage">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingLeft="@dimen/vs_20"
                android:paddingRight="@dimen/vs_20"
                android:paddingTop="@dimen/vs_20"
                android:paddingBottom="@dimen/vs_20"
                android:visibility="invisible"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_20"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/vs_20" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewFilter"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingLeft="@dimen/vs_20"
                android:paddingRight="@dimen/vs_20"
                android:paddingTop="@dimen/vs_20"
                android:paddingBottom="@dimen/vs_20"
                android:visibility="gone"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_20"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/vs_20" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</layout>
