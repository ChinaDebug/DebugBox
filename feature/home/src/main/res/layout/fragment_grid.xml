<?xml version="1.0" encoding="utf-8"?>
<!-- 视频分类页面略缩图样式 -->
<!-- 根用 FrameLayout：网格与加载覆盖层层叠，而非 LinearLayout 线性排列（线性会把覆盖层排到网格下方屏幕外） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/mGridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/vs_60"
        android:paddingTop="@dimen/vs_20"
        android:paddingRight="@dimen/vs_60"
        android:paddingBottom="@dimen/vs_20"
        app:tv_horizontalSpacingWithMargins="@dimen/vs_20"
        app:tv_verticalSpacingWithMargins="@dimen/vs_20" />

    <!-- 覆盖式加载态：刷新时叠加在网格上方而非替换网格，避免卡片全部消失造成的闪屏观感 -->
    <FrameLayout
        android:id="@+id/grid_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="@dimen/vs_100"
            android:layout_height="@dimen/vs_100"
            android:layout_gravity="center"
            android:background="@drawable/shape_loading_card"
            android:gravity="center">

            <ProgressBar
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:layout_gravity="center"
                android:indeterminateOnly="true"
                android:indeterminateTint="?attr/color_theme_70"
                android:indeterminateTintMode="src_atop" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>