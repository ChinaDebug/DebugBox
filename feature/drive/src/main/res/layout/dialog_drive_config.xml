<?xml version="1.0" encoding="utf-8"?>
<!-- 网盘配置对话框 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/vs_600"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_30">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vs_20"
        android:text="@string/drive_add"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_28"
        android:textStyle="bold" />

    <com.tvbox.kotlin.core.ui.widget.CustomEditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:background="@drawable/input_dialog_api_input"
        android:hint="@string/drive_name_hint"
        android:inputType="text"
        android:maxLines="1"
        android:paddingLeft="@dimen/vs_15"
        android:paddingRight="@dimen/vs_15"
        android:textColor="@android:color/white"
        android:textColorHint="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_22" />

    <Spinner
        android:id="@+id/spinnerType"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:layout_marginTop="@dimen/vs_15"
        android:background="@drawable/input_dialog_api_input"
        android:paddingLeft="@dimen/vs_10"
        android:paddingRight="@dimen/vs_10" />

    <com.tvbox.kotlin.core.ui.widget.CustomEditText
        android:id="@+id/etUrl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:layout_marginTop="@dimen/vs_15"
        android:background="@drawable/input_dialog_api_input"
        android:hint="@string/drive_addr_hint"
        android:inputType="textUri"
        android:maxLines="1"
        android:paddingLeft="@dimen/vs_15"
        android:paddingRight="@dimen/vs_15"
        android:textColor="@android:color/white"
        android:textColorHint="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_22" />

    <com.tvbox.kotlin.core.ui.widget.CustomEditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:layout_marginTop="@dimen/vs_15"
        android:background="@drawable/input_dialog_api_input"
        android:hint="@string/drive_username_webdav"
        android:inputType="text"
        android:maxLines="1"
        android:paddingLeft="@dimen/vs_15"
        android:paddingRight="@dimen/vs_15"
        android:textColor="@android:color/white"
        android:textColorHint="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_22" />

    <com.tvbox.kotlin.core.ui.widget.CustomEditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:layout_marginTop="@dimen/vs_15"
        android:background="@drawable/input_dialog_api_input"
        android:hint="@string/drive_password_webdav"
        android:inputType="textPassword"
        android:maxLines="1"
        android:paddingLeft="@dimen/vs_15"
        android:paddingRight="@dimen/vs_15"
        android:textColor="@android:color/white"
        android:textColorHint="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_22" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_25"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_60"
            android:layout_weight="1"
            android:background="@drawable/button_dialog_main"
            android:text="@string/dialog_cancel"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />

        <Space
            android:layout_width="@dimen/vs_20"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_60"
            android:layout_weight="1"
            android:background="@drawable/button_dialog_main_selected"
            android:text="@string/dialog_confirm"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>
</LinearLayout>
