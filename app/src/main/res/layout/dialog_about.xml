<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/vs_600"
    android:layout_height="@dimen/vs_400"
    android:layout_gravity="center"
    android:background="@drawable/shape_dialog_bg_main"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_30"
    android:paddingTop="@dimen/vs_30"
    android:paddingRight="@dimen/vs_30"
    android:paddingBottom="@dimen/vs_10">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/shape_about_scroll_border"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:focusable="true"
        android:overScrollMode="never"
        android:padding="@dimen/vs_10"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:shadowColor="@color/color_000000_60"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            android:text="1. 本软件仅提供网络资源聚合与展示功能，所有内容均由用户自行获取、导入或配置，软件本身不参与任何资源的制作、上传、存储、下载、转码或分发。\n\n2. 软件仅供个人学习、技术研究与交流参考，请于下载或安装后24小时内自行删除。请勿将本软件用于任何商业用途或违反当地法律法规的场景。\n\n3. 使用者应对其使用行为及由此产生的一切后果承担全部责任。因使用本软件而产生的任何版权、隐私、安全或其他法律纠纷，均与开发者无关。"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_20" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_15"
        android:lineSpacingMultiplier="1.2"
        android:text="打包、转载或二次分发时，请保留原始出处：\nhttps://github.com/CatVodTVOfficial/TVBoxOSC\nhttps://github.com/ChinaDebug/DebugBox"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_20" />

    <TextView
        android:id="@+id/tvBuildTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/vs_6"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_16" />

</LinearLayout>